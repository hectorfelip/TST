{
  "name": "barbershop-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:create-barbershop": "tsx scripts/create-barbershop.mts",
    "db:test-start": "bash scripts/test-db.sh start",
    "db:test-stop": "bash scripts/test-db.sh stop",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:all": "npm test && npm run test:db",
    "db:seed": "tsx scripts/seed-demo.mts"
  },
  "dependencies": {
    "next": "16.3.7",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
