# Copy to .env.local (never commit real values).

# The application connects as app_user: it CANNOT bypass Row Level Security.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/barbershop

# The database OWNER: used ONLY by migrations and admin scripts (npm run db:migrate,
# db:create-barbershop, db:seed). Never give it to the running application.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/barbershop

# Tests against a real database (npm run test:db). Any EMPTY PostgreSQL >= 15 where the
# user can create databases and roles. Without it, scripts/test-db.sh starts a throw-away one.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Supabase (docs/04-data.md section 13):
#  - DATABASE_URL (the app): the TRANSACTION pooler, user "app_user.<project-ref>".
#  - DATABASE_ADMIN_URL (migrations, backups): the DIRECT connection (or the SESSION pooler if you have no IPv6).
#  - Never put the Supabase "service_role" key anywhere in this project.

# --- Step 5 (the running application) ---
# Signs the login cookie. Anyone who knows it can pretend to be anybody: keep it secret, and change it to log everyone out.
#   openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_TEXT_OF_AT_LEAST_32_CHARACTERS
# Protects /api/jobs/expiry (the daily job). The scheduler sends it as "Authorization: Bearer <value>".
CRON_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_TEXT
# Connections kept open per instance (keep it small behind a transaction pooler).
# DB_POOL_MAX=5
