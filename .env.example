# Copy to .env.local (never commit real values).

# The application connects as app_user: it CANNOT bypass Row Level Security.
DATABASE_URL=postgres://app_user:CHANGE_ME@localhost:5432/barbershop

# The database OWNER: used ONLY by migrations and admin scripts (npm run db:migrate,
# db:create-barbershop, db:seed). Never give it to the running application.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME@localhost:5432/barbershop

# Tests against a real database (npm run test:db). Any EMPTY PostgreSQL >= 15 where the
# user can create databases and roles. Without it, scripts/test-db.sh starts a throw-away one.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
